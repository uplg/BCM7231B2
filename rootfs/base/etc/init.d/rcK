#!/bin/sh
# Shutdown (inittab): stop the services, then take the backup disk down cleanly before init
# kills what is left. Init does not respawn anything while this runs.
echo "[shutdown] Stopping services..."
# the supervise loops first, or they would start syslogd and klogd again
killall supervise wifi-watch kird crond ntpd 2>/dev/null
# the SFTP sessions hold files open on the backup disk
killall sshd sshd-session 2>/dev/null
killall wpa_supplicant udhcpc 2>/dev/null
sync
if mountpoint -q /srv/backup; then
    echo "[shutdown] Unmounting /srv/backup..."
    killall syslogd klogd 2>/dev/null   # syslogd writes its log on the disk
    sleep 1
    umount /srv/backup 2>/dev/null || mount -o remount,ro /srv/backup
fi
echo "[shutdown] Unmounting filesystems..."
umount -a -r 2>/dev/null
sync
echo "[shutdown] System halted."
