#!/bin/sh
# kird: Ruwido remote -> maison HTTP bridge. Off unless /etc/kird.conf sets KIRD_ENABLE=1 (an
# on-box edit persists via the /config overlay; then run this script). Idempotent.
[ -x /usr/sbin/kird ] && [ -f /etc/kird.conf ] || exit 0
. /etc/kird.conf
[ "$KIRD_ENABLE" = 1 ] || exit 0
# The real daemon only: a bare `pidof kird` also matches this script (its comm is "kird" too)
for pid in $(pidof kird); do
    [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = /usr/sbin/kird ] && exit 0
done
export KIRD_URL KIRD_TOKEN KIRD_DEVICE
(
    while :; do
        /usr/sbin/kird 2>&1 | logger -t kird
        sleep 5
    done
) </dev/null >/dev/null 2>&1 &
