# Build output (kernel, binaries, build logs)
/build_output/

# Makefile stamps + downloaded source tarball cache
/build/

# Assembled rootfs tree, and its UBI images (make ubi / make tftp)
/new_rootfs/
/rootfs.ubifs
/rootfs.ubi
/rootfs-cfe.ubi

# Personal files baked into the rootfs, not for the repo (device/*.example are the templates)
# root's SSH keys
device/authorized_keys
# root's password (UART console), generated by mkrootfs.sh
device/root-password
# WiFi credentials
device/wpa_supplicant.conf
# kird: maison URL + API token
device/kird.conf
# backup target: the servers' public keys (one backup account each)
device/vykar/

# CFE environment dump: contains device HDCP keys and serial number
/defaultenv.txt

# Extracted stock firmware rootfs (~143 MB)
/rootfs_extracted/

# Full MTD backup from device (~124 MB)
/backup/

# UART console logs (make connect)
/logs/

# macOS
.DS_Store
