# Build output (kernel, busybox, binaries, logs)
build_output/

# Makefile stamps + downloaded source tarball cache
build/

# SSH material baked into the rootfs (personal, not for the repo)
device/authorized_keys
device/dropbear/

# WiFi credentials baked into the rootfs (personal, not for the repo)
device/wpa_supplicant.conf

# kird config baked into the rootfs (LAN IP + API token, not for the repo)
device/kird.conf

# CFE environment dump — contains device HDCP keys and serial number
defaultenv.txt

.ruff_cache/

# Assembled rootfs tree and squashfs image
new_rootfs/
new_rootfs.squashfs

# Extracted stock firmware rootfs (~143 MB)
rootfs_extracted/

# Full MTD backup from device (~124 MB)
backup/

# Build logs
logs/

# macOS
.DS_Store

__pycache__
# Backup target: the servers' public keys (one backup account each)
device/vykar/

# Root password (UART console), generated by mkrootfs.sh
device/root-password

# rootfs UBI images (make ubi / make tftp)
rootfs.ubi
rootfs-cfe.ubi
