# Wi-Fi diagnostics (make kernel WIFI_DEBUG=1): debugfs with rtw88's registers, firmware and
# counters, and mac80211's, plus rtw88's debug messages (mask in /sys/module/rtw88_core/
# parameters/debug_mask). For investigations only: not in the everyday kernel.
CONFIG_DEBUG_FS=y
CONFIG_RTW88_DEBUG=y
CONFIG_RTW88_DEBUGFS=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_CFG80211_DEBUGFS=y
