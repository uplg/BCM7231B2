// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

/* Top 1 MB of RAM bank0, reserved for the XPT MSG DMA ring and the PB0
 * playback source buffers (programmed from userspace by src/xpt_cap.c). */
/memreserve/ 0x0ff00000 0x00100000;

/* 2 MB at 12 MB, reserved for the XPT_RAVE CDB record ring.  The RAVE CDB
 * pointer is a 24-bit MEMC device offset with no high-address window, so the
 * ring MUST sit in the low 16 MB of DRAM (kernel lives in 0..~6 MB; this is
 * clear of it).  See do_rave() in src/xpt_cap.c. */
/memreserve/ 0x00c00000 0x00200000;

#include "bcm7231.dtsi"

/ {
	compatible = "airties,air7310t", "brcm,bcm7231";
	model = "AirTies AIR 7310T";

	memory@0 {
		device_type = "memory";
		/* 256 MB at 0x00000000 + 256 MB at 0x20000000 */
		reg = <0x00000000 0x10000000>,
		      <0x20000000 0x10000000>;
	};

	chosen {
		/* libata.force: the SATA link fails 8b/10b decoding (BadCRC, Dispar)
		 * at 6 and 3 Gbps on this board; 1.5 Gbps is stable and still beyond
		 * what a hard disk streams.
		 * rcutree.kthread_prio: RCU kthreads run SCHED_FIFO, so a CPU-bound
		 * network load cannot starve them (48 s stall, box frozen).
		 * rtw88_usb.switch_usb_mode=0: the BCM7231 has no USB 3 host; at probe
		 * rtw88 switched the RTL8812BU to USB 3 anyway, the dongle dropped off
		 * the bus mid-write (-71 errors) and came back in USB 2.
		 * ubi.mtd/root=ubi0:rootfs: the rootfs is UBIFS in the UBI volume named
		 * "rootfs" on mtd5 (RootFS), mounted read-only by that name (UBI
		 * handles the NAND's bad blocks, mtdblock did not). By name, not by
		 * volume id: an update writes "rootfs_new" and swaps the names; a
		 * squashfs through ubiblock was found by id (ubiblock0_<id>) and that
		 * swap left the kernel without a root (panic loop, 2026-10-25). */
		bootargs = "console=ttyS0,115200 ubi.mtd=RootFS root=ubi0:rootfs rootfstype=ubifs ro init=/sbin/init libata.force=1.5Gbps rcutree.kthread_prio=10 rtw88_usb.switch_usb_mode=0";
		stdout-path = &uart0;
	};
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&enet0 {
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&nand {
	status = "okay";

	nandcs@0 {
		compatible = "brcm,nandcs";
		reg = <0>;
		nand-on-flash-bbt;

		nand-ecc-strength = <1>;
		nand-ecc-step-size = <512>;
		brcm,nand-oob-sector-size = <16>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "CFE";
				reg = <0x00000000 0x00200000>;
				read-only;
			};

			partition@200000 {
				label = "ENV";
				reg = <0x00200000 0x00100000>;
			};

			partition@300000 {
				label = "ConfigFS";
				reg = <0x00300000 0x00600000>;
			};

			partition@900000 {
				label = "Reserve";
				reg = <0x00900000 0x00a00000>;
			};

			partition@1300000 {
				label = "Kernel";
				reg = <0x01300000 0x00700000>;
			};

			partition@1a00000 {
				label = "RootFS";
				reg = <0x01a00000 0x04600000>;
			};

			partition@6000000 {
				label = "Recovery";
				reg = <0x06000000 0x01c00000>;
			};
		};
	};
};

&sata {
	status = "okay";
};

&sata_phy {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&kir {
	status = "okay";
};

&bsc_a {
	status = "okay";
};

&bsc_b {
	status = "okay";
};

&bsc_c {
	status = "okay";
};
