From: =?UTF-8?q?L=C3=A9onard?= <leonard@synthe.se>
Date: Wed, 4 Nov 2026 10:53:57 +0100
Subject: [PATCH 103/104] Input: Add the BCM7231 KIR infrared receiver

Hook the BCM7231 KIR driver into the build. The driver itself
(bcm7231-kir.c) is copied into drivers/input/keyboard/ by the build
(kernel/ in this repo). Local: upstream would want it as an rc-core
driver in drivers/media/rc, with a keymap for the remote.
---
 drivers/input/keyboard/Kconfig  | 9 +++++++++
 drivers/input/keyboard/Makefile | 1 +
 2 files changed, 10 insertions(+)

diff --git a/drivers/input/keyboard/Kconfig b/drivers/input/keyboard/Kconfig
index d8c64f3..15d6997 100644
--- a/drivers/input/keyboard/Kconfig
+++ b/drivers/input/keyboard/Kconfig
@@ -737,6 +737,15 @@ config KEYBOARD_BCM
 	  To compile this driver as a module, choose M here: the
 	  module will be called bcm-keypad.
 
+config KEYBOARD_BCM7231_KIR
+	bool "Broadcom BCM7231 KIR (IR receiver)"
+	depends on OF && HAS_IOMEM
+	help
+	  Say Y here to receive the keys of an infrared remote through the
+	  KIR block of the Broadcom BCM7231 (the Ruwido remote of the
+	  AirTies AIR 7310T). Its programming was reverse engineered from
+	  the stock firmware.
+
 config KEYBOARD_MT6779
 	tristate "MediaTek Keypad Support"
 	depends on ARCH_MEDIATEK || COMPILE_TEST
diff --git a/drivers/input/keyboard/Makefile b/drivers/input/keyboard/Makefile
index 60bb7ba..cdde017 100644
--- a/drivers/input/keyboard/Makefile
+++ b/drivers/input/keyboard/Makefile
@@ -14,6 +14,7 @@ obj-$(CONFIG_KEYBOARD_APPLESPI)		+= applespi.o
 obj-$(CONFIG_KEYBOARD_ATARI)		+= atakbd.o
 obj-$(CONFIG_KEYBOARD_ATKBD)		+= atkbd.o
 obj-$(CONFIG_KEYBOARD_BCM)		+= bcm-keypad.o
+obj-$(CONFIG_KEYBOARD_BCM7231_KIR)	+= bcm7231-kir.o
 obj-$(CONFIG_KEYBOARD_CAP11XX)		+= cap11xx.o
 obj-$(CONFIG_KEYBOARD_CHARLIEPLEX)	+= charlieplex_keypad.o
 obj-$(CONFIG_KEYBOARD_CLPS711X)		+= clps711x-keypad.o
